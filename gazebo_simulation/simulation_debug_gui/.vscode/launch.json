    "version": "0.2.0",
    "configurations": [
    {
        "name": "OSPR-AI Monitor (debug)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/gui.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "python": "/usr/bin/python3",
        "env": {
            "PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION": "python"
        },
        "justMyCode": false
    }
  ]
}